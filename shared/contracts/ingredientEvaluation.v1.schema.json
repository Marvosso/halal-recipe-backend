{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halalkitchen.app/contracts/ingredient-evaluation.v1.json",
  "title": "IngredientEvaluationV1",
  "description": "Canonical Halal Kitchen ingredient evaluation response (deterministic verdict fields).",
  "type": "object",
  "required": [
    "contract_version",
    "ingredient",
    "query",
    "base_ingredient",
    "modifiers",
    "halal_status",
    "confidence",
    "warnings",
    "explanation",
    "references",
    "substitutes"
  ],
  "additionalProperties": true,
  "properties": {
    "contract_version": { "const": "1" },
    "ingredient": { "type": "string", "description": "Normalized ingredient identifier (slug or resolved text)" },
    "query": { "type": "string", "description": "Original user-facing query" },
    "resolved_query": { "type": "string" },
    "base_ingredient": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["slug", "display_name"],
          "properties": {
            "slug": { "type": "string" },
            "display_name": { "type": "string" },
            "category": { "type": "string" }
          }
        }
      ]
    },
    "modifiers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modifier_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "display_name": { "type": "string" },
          "effect": { "type": "string" },
          "matched_text": { "type": "string" }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["halal", "usually_halal", "conditional", "usually_haram", "haram", "unknown"]
    },
    "halal_status": {
      "type": "string",
      "enum": ["halal", "conditional", "haram", "unknown"]
    },
    "confidence": {
      "type": "object",
      "required": ["level", "score"],
      "properties": {
        "level": { "enum": ["high", "medium", "low"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "value": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "type": { "type": "string" }
        }
      }
    },
    "explanation": { "type": "string" },
    "explanation_source": { "enum": ["template", "ai", "deterministic_template"] },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref_type": { "type": "string" },
          "ref_text": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "substitutes": {
      "type": "object",
      "properties": {
        "best": { "$ref": "#/$defs/substitute" },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/substitute" }
        }
      }
    },
    "meta": { "type": "object" }
  },
  "$defs": {
    "substitute": {
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "score": { "type": "number" }
      }
    }
  }
}
